# Copy this file to .env. Every `make` target (make run, make test, ...)
# loads it automatically and exports its values — see Makefile. The Go
# binary itself still never reads .env files directly (internal/config.Load
# only reads real environment variables); running `go run ./cmd/api`
# outside `make` still needs these exported manually. See SETUP.md.

# Required. Standard PostgreSQL connection string. This exact
# user/password/database name matches what docker-compose.yml also uses,
# so the same value works whether Postgres runs natively or via Docker
# (only the host differs: "localhost" natively, "postgres" under Compose).
VAANISETU_DATABASE_URL=postgres://vaanisetu:vaanisetu@localhost:5432/vaanisetu?sslmode=disable

# Optional. Defaults shown.
VAANISETU_PORT=8080
VAANISETU_LOG_LEVEL=info

# Optional. The one origin CORS allows (never "*"). Default shown matches
# Angular's dev server (`ng serve`).
VAANISETU_ALLOWED_ORIGIN=http://localhost:4200

# Optional. Leave unset/commented to use llm.FakeLLMClient (no real model,
# canned per-language replies) — the smallest setup, no ai-services/
# checkout needed. The Python `llm` service now exists (Milestone 2b): to
# use it instead, run `cd ai-services && make download-models && make run`
# (see ai-services/models.yaml for which model that downloads — currently
# llama-3.2-3b-instruct, ADR-016) and uncomment this line.
# VAANISETU_LLM_SERVICE_URL=http://localhost:8090

# Optional. Leave unset/commented to use asr.FakeASRClient (a canned
# per-language transcript, no real speech recognition) — the smallest
# setup, no extra model download needed. The Python `asr` capability now
# exists (Milestone 3b), hosted in the same ai-services process as `llm`:
# to use it instead, run
# `cd ai-services && uv run scripts/download_models.py --capability asr && make run`
# (see ai-services/models.yaml for which model that downloads — currently
# faster-whisper-large-v3-turbo, ADR-018) and uncomment this line — same
# host:port as VAANISETU_LLM_SERVICE_URL above.
# VAANISETU_ASR_SERVICE_URL=http://localhost:8090

# Optional. Leave unset/commented to use tts.FakeTTSClient (a short,
# generated placeholder tone, no real speech synthesis) — the smallest
# setup, no extra model download needed. The Python `tts` capability now
# exists (Milestone 4b), hosted in the same ai-services process as
# `llm`/`asr`: to use it instead, run
# `cd ai-services && uv run scripts/download_models.py --capability tts && make run`
# (see ai-services/models.yaml for which model that downloads — currently
# selected per ADR-021) and uncomment this line — same host:port as
# VAANISETU_LLM_SERVICE_URL above.
# VAANISETU_TTS_SERVICE_URL=http://localhost:8090
