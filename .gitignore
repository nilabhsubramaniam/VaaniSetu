# VaaniSetu — single root .gitignore for the whole monorepo
# (frontend/, backend/, ai-services/). No nested .gitignore files are
# used unless a workspace later demonstrates a real technical need for
# one that these root patterns can't express.
#
# Every rule below is tied to either tooling actually in this repo
# (Angular + npm in frontend/), a convention already documented in
# docs/DEVELOPMENT.md for backend/ai-services (Phase 2+, not built yet),
# or a generated-only artifact that no project ever commits intentionally.

# --- Dependencies ---
node_modules/

# --- Frontend build output / cache (Angular, frontend/) ---
dist/
.angular/
coverage/

# --- npm logs ---
npm-debug.log*
yarn-error.log*

# --- Python (ai-services/, Phase 2+) ---
# __pycache__, venvs and *.pyc are interpreter-generated regardless of
# which dependency/lint tool ends up chosen (docs/DEVELOPMENT.md marks
# that choice TBD); pytest/mypy/ruff caches are listed because
# docs/DEVELOPMENT.md already names pytest, and the others are always
# safe to ignore even if never adopted.
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Generated ASR benchmark audio (ai-services/, Phase 3) ---
# Synthesized on demand by scripts/generate_audio_fixtures.py from the
# committed eval_data/asr_fixtures.yaml manifest — regenerable, not a
# real recorded corpus, so it stays out of git the same way build output
# does.
/ai-services/eval_data/audio/

# --- Go (backend/, Phase 2+) ---
# Compiled output and test binaries; go.sum/go.mod stay tracked. `go build
# ./...` from backend/ with no -o flag names the binary after the cmd/
# directory with no extension at all on macOS/Linux (here, `api`, from
# cmd/api) — anchored to backend/ specifically so this can't accidentally
# match something meaningful elsewhere in the tree the way an unanchored
# bare `api` pattern could (e.g. internal/api/).
/backend/api
*.exe
*.dll
*.so
*.dylib
*.test
vendor/

# --- Local model weights and caches ---
# Never committed — docs/DEVELOPMENT.md §15 "Model file handling". Anchored
# to the repo root: docs/DEVELOPMENT.md's target tree places this as one
# top-level `models/` directory alongside frontend/backend/ai-services, not
# any directory named "models" anywhere in the tree — unanchored, this
# pattern was also matching (and silently untracking) the real TypeScript
# source folder frontend/src/app/core/models/.
/models/
*.gguf
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.ckpt

# --- Environment / secrets ---
# docs/DEVELOPMENT.md "Secret management": local env files are never
# committed; a checked-in .env.example template is always kept.
.env
.env.*
!.env.example

# --- Editor / IDE metadata (user-specific) ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.idea/
*.swp
*.swo
*~

# --- OS-specific files ---
.DS_Store
Thumbs.db
Desktop.ini
