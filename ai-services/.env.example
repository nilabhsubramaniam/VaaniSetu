# Copy to ai-services/.env for local development. All variables are
# optional — see app/config.py for the defaults each falls back to.

# Port this service listens on. Must match what the backend's
# VAANISETU_LLM_SERVICE_URL points at.
VAANISETU_LLM_PORT=8090

# Path to the model registry. Default: ai-services/models.yaml.
# VAANISETU_LLM_MODEL_REGISTRY=./models.yaml

# Directory the registry's GGUF filenames are resolved against. Default:
# <repo root>/models/llm — git-ignored, never committed.
# VAANISETU_LLM_MODEL_STORE=../models/llm

# One of debug, info, warn, error.
VAANISETU_LLM_LOG_LEVEL=info
